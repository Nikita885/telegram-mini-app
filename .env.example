# ─── Outfit Share: server settings ───────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Domain the app is served on (HTTPS is required by Telegram).
DOMAIN=moiservis.pro
PUBLIC_BASE_URL=https://moiservis.pro

# Django. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
SECRET_KEY=change-me

# Telegram bot from @BotFather (token + username without @).
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# PostgreSQL (the db container is created with these credentials).
POSTGRES_DB=outfits
POSTGRES_USER=outfits
POSTGRES_PASSWORD=change-me

# Local port the web container listens on (127.0.0.1 only; HTTPS proxy in front).
APP_PORT=8010

# Studio pipeline. On servers with < 4 GB RAM use u2netp (smaller, less precise).
STUDIO_BG_MODEL=isnet-general-use
WORKER_CONCURRENCY=1
WORKER_MEMORY=3g

# Only for local testing: sign in with any Telegram ID, no bot needed. Keep False on a server.
ALLOW_DEV_LOGIN=False

# Optional: store media in Cloudinary instead of the server disk.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
