# ─── Outfit Share: server settings ───────────────────────────────────────────
# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Domain the app is served on (HTTPS is required by Telegram).
DOMAIN=moiservis.pro
PUBLIC_BASE_URL=https://moiservis.pro
# Add www.moiservis.pro here too if you create a DNS record for it.
ALLOWED_HOSTS=moiservis.pro,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://moiservis.pro

# Django. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
SECRET_KEY=change-me

# Telegram bot from @BotFather (token + username without @).
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# PostgreSQL (the db container is created with these credentials on first start).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=outfits
POSTGRES_USER=outfits
POSTGRES_PASSWORD=change-me

# Local port the web container listens on (127.0.0.1 only; the HTTPS proxy talks to it).
# Pick a port no other project on the server uses.
APP_PORT=8010

# Number of HTTPS proxies in front of the app (nginx or Caddy = 1). Used to find the client address
# for rate limits; keep 1 unless you chain proxies.
TRUSTED_PROXIES=1

# Memory limits, so this stack cannot starve other projects on the same server.
WEB_MEMORY=1g
WORKER_MEMORY=3g

# Studio pipeline. On servers with < 4 GB RAM use u2netp (smaller, less precise).
STUDIO_BG_MODEL=isnet-general-use
WORKER_CONCURRENCY=1

# Android App Links: SHA-256 fingerprint(s) of the APK signing certificate, comma-separated
# (keytool -list -v -keystore <file>). Shared https links then open straight in the app.
ANDROID_APP_CERT_SHA256=

# Only for local testing: sign in with any Telegram ID, no bot needed. Keep False on a server.
ALLOW_DEV_LOGIN=False

# Optional: store media in Cloudinary instead of the server disk.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
