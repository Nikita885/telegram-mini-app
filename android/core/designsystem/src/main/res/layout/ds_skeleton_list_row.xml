<?xml version="1.0" encoding="utf-8"?>
<!-- Скелетон строки списка: аватар 40 + две строки (диалоги, подписчики, уведомления). -->
<app.outfitshare.core.designsystem.component.skeleton.SkeletonLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/ds_layout_gutter"
    android:paddingTop="@dimen/ds_layout_list_item_padding_vertical"
    android:paddingEnd="@dimen/ds_layout_gutter"
    android:paddingBottom="@dimen/ds_layout_list_item_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ds_size_list_item_min_height"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/ds_size_avatar_m"
            android:layout_height="@dimen/ds_size_avatar_m"
            android:background="@drawable/ds_bg_skeleton_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <include layout="@layout/ds_skeleton_line_long" />

            <include
                layout="@layout/ds_skeleton_line_short"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2" />
        </LinearLayout>
    </LinearLayout>
</app.outfitshare.core.designsystem.component.skeleton.SkeletonLayout>
