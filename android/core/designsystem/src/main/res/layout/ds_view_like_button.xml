<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/ds_like_icon"
        android:layout_width="@dimen/ds_size_icon"
        android:layout_height="@dimen/ds_size_icon"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ds_ic_favorite_toggle"
        app:tint="@color/ds_like_tint" />

    <TextView
        android:id="@+id/ds_like_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_1"
        android:fontFeatureSettings="tnum"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/dsColorOnSurface"
        android:visibility="gone" />
</merge>
