<?xml version="1.0" encoding="utf-8"?>
<!-- Состояния экрана. Сообщение прокручивается: при шрифте 200 % текст не обрезается. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <FrameLayout
        android:id="@+id/ds_state_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/ds_state_loading"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/ds_state_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:indeterminate="true" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/ds_state_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ds_state_illustration"
                android:layout_width="@dimen/ds_size_illustration"
                android:layout_height="@dimen/ds_size_illustration"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/ds_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:gravity="center"
                android:maxWidth="@dimen/ds_layout_max_dialog_width"
                android:textAppearance="?attr/textAppearanceHeadlineLarge"
                android:textColor="?attr/dsColorOnSurface" />

            <TextView
                android:id="@+id/ds_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:gravity="center"
                android:maxWidth="@dimen/ds_layout_max_dialog_width"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/dsColorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ds_state_action"
                style="@style/Widget.Ds.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ds_state_secondary_action"
                style="@style/Widget.Ds.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</merge>
