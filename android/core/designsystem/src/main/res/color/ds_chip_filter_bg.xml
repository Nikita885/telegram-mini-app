    <item android:alpha="@dimen/ds_opacity_disabled_container" android:color="?attr/dsColorOnSurface" android:state_checked="true" android:state_enabled="false" />
    <item android:color="?attr/dsColorPrimary" android:state_checked="true" />
    <item android:color="@android:color/transparent" />
</selector>
