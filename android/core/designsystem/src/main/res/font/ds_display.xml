<?xml version="1.0" encoding="utf-8"?>
<!-- СГЕНЕРИРОВАНО tools/designsystem/build_fonts.py. Семейство OutfitShare Display (производная Playfair Display, OFL). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/ds_display_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/ds_display_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/ds_display_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/ds_display_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/ds_display_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/ds_display_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />
</font-family>
