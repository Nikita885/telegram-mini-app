    <!-- Текст на inverseSurface. -->
    <color name="ds_color_inverse_on_surface">@color/ds_light_inverse_on_surface</color>
    <!-- Действие в снекбаре («Отменить»). -->
    <color name="ds_color_inverse_accent">@color/ds_light_inverse_accent</color>
    <!-- Заливка сердца. Совпадает с accent: лайк — главный эмоциональный момент бренда. -->
    <color name="ds_color_like">@color/ds_light_like</color>
    <!-- Кольцо клавиатурного/switch-фокуса. -->
    <color name="ds_color_focus_ring">@color/ds_light_focus_ring</color>
    <!-- Затемнение под bottom sheet и диалогами. -->
    <color name="ds_color_scrim">@color/ds_light_scrim</color>
    <!-- Нижний градиент на фото для подписи поверх изображения. -->
    <color name="ds_color_photo_scrim">@color/ds_light_photo_scrim</color>
    <!-- Текст/иконки поверх фото (всегда на photoScrim). -->
    <color name="ds_color_on_photo">@color/ds_light_on_photo</color>
    <!-- Основа скелетона: заметно темнее фона, чтобы форма контента читалась. -->
    <color name="ds_color_skeleton_base">@color/ds_light_skeleton_base</color>
    <!-- Блик шиммера. -->
    <color name="ds_color_skeleton_highlight">@color/ds_light_skeleton_highlight</color>
    <!-- Фон холста конструктора (студийная «бумага»). -->
    <color name="ds_color_canvas">@color/ds_light_canvas</color>
    <!-- Заливка манекена. -->
    <color name="ds_color_mannequin">@color/ds_light_mannequin</color>
    <!-- Подсветка зоны примагничивания на манекене. -->
    <color name="ds_color_snap_guide">@color/ds_light_snap_guide</color>
    <!-- Рамка выбранного слоя / доводимой точки. -->
    <color name="ds_color_selection">@color/ds_light_selection</color>
    <!-- Фон камеры Студии — всегда тёмный, чтобы не засвечивать кадр. -->
    <color name="ds_color_camera_background">@color/ds_light_camera_background</color>
    <!-- Контролы поверх камеры. -->
    <color name="ds_color_on_camera">@color/ds_light_on_camera</color>
