    <!-- Семантические алиасы: переключаются квалификатором -night -->
    <!-- Фон экрана. Молочный днём, почти чёрный графит ночью. -->
    <color name="ds_color_background">@color/ds_light_background</color>
    <!-- Основной текст и иконки на фоне. -->
    <color name="ds_color_on_background">@color/ds_light_on_background</color>
    <!-- Поднятые поверхности: bottom sheet, диалоги, меню. -->
    <color name="ds_color_surface">@color/ds_light_surface</color>
    <!-- Основной текст на поверхностях. -->
    <color name="ds_color_on_surface">@color/ds_light_on_surface</color>
    <!-- Вторичный текст: подписи, мета, плейсхолдеры, неактивные иконки. -->
    <color name="ds_color_on_surface_variant">@color/ds_light_on_surface_variant</color>
    <!-- Утопленные зоны: плейсхолдер фото, поля ввода, плитка вещи. -->
    <color name="ds_color_surface_sunken">@color/ds_light_surface_sunken</color>
    <!-- M3 surfaceContainerLowest. -->
    <color name="ds_color_surface_container_lowest">@color/ds_light_surface_container_lowest</color>
    <!-- M3 surfaceContainerLow. -->
    <color name="ds_color_surface_container_low">@color/ds_light_surface_container_low</color>
    <!-- M3 surfaceContainer: навбар, карточки настроек. -->
    <color name="ds_color_surface_container">@color/ds_light_surface_container</color>
    <!-- M3 surfaceContainerHigh: выбранный элемент навигации, тональные зоны. -->
    <color name="ds_color_surface_container_high">@color/ds_light_surface_container_high</color>
    <!-- M3 surfaceContainerHighest: трек слайдера, разделители-плашки. -->
    <color name="ds_color_surface_container_highest">@color/ds_light_surface_container_highest</color>
    <!-- Контур значимых элементов (поля, secondary-кнопка, чип). Контраст ≥ 3:1. -->
    <color name="ds_color_outline">@color/ds_light_outline</color>
    <!-- Декоративные разделители. Контраст не нормируется. -->
    <color name="ds_color_outline_variant">@color/ds_light_outline_variant</color>
    <!-- Главное действие (primary-кнопка). Графит днём, молочный ночью — монохром как в журнале. -->
    <color name="ds_color_primary">@color/ds_light_primary</color>
    <!-- Текст/иконка на primary. -->
    <color name="ds_color_on_primary">@color/ds_light_on_primary</color>
    <!-- Фирменный ультрамарин. Только «моменты»: лайк, непрочитанное, ссылки, фокус, snap-подсветка, прогресс. -->
    <color name="ds_color_accent">@color/ds_light_accent</color>
    <!-- Контент на accent. -->
    <color name="ds_color_on_accent">@color/ds_light_on_accent</color>
    <!-- Мягкая подложка акцента: выбранный фильтр-чип «Новое», инфо-баннер. -->
    <color name="ds_color_accent_container">@color/ds_light_accent_container</color>
    <!-- Контент на accentContainer. -->
    <color name="ds_color_on_accent_container">@color/ds_light_on_accent_container</color>
    <!-- Ошибки и разрушающие действия (удалить, выйти, заблокировать). -->
    <color name="ds_color_danger">@color/ds_light_danger</color>
    <!-- Контент на danger. -->
    <color name="ds_color_on_danger">@color/ds_light_on_danger</color>
    <!-- Подложка ошибки (баннер, поле с ошибкой). -->
    <color name="ds_color_danger_container">@color/ds_light_danger_container</color>
    <!-- Контент на dangerContainer. -->
    <color name="ds_color_on_danger_container">@color/ds_light_on_danger_container</color>
    <!-- Успех: вещь опубликована, качество кадра ок, онлайн. -->
    <color name="ds_color_success">@color/ds_light_success</color>
    <!-- Подложка успеха. -->
    <color name="ds_color_success_container">@color/ds_light_success_container</color>
    <!-- Контент на successContainer. -->
    <color name="ds_color_on_success_container">@color/ds_light_on_success_container</color>
    <!-- Предупреждение: слабый свет, низкий fit score, офлайн. -->
    <color name="ds_color_warning">@color/ds_light_warning</color>
    <!-- Подложка предупреждения (офлайн-баннер). -->
    <color name="ds_color_warning_container">@color/ds_light_warning_container</color>
    <!-- Контент на warningContainer. -->
    <color name="ds_color_on_warning_container">@color/ds_light_on_warning_container</color>
    <!-- Снекбар, тултип. -->
