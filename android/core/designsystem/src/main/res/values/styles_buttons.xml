<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Кнопки. Высота 48 dp = минимальная зона касания, поэтому вертикальные инсеты нулевые.
        Primary — монохромная (графит/молочный), акцент в кнопках не используется.
    -->
    <style name="Widget.Ds.Button.Primary" parent="Widget.Material3.Button">
        <!-- При шрифте 200 % подпись переносится на вторую строку, кнопка растёт по высоте. -->
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">@dimen/ds_size_button_height</item>
        <item name="android:minWidth">@dimen/ds_size_touch_target</item>
        <item name="android:insetTop">@dimen/ds_space_0</item>
        <item name="android:insetBottom">@dimen/ds_space_0</item>
        <item name="android:paddingStart">@dimen/ds_space_6</item>
        <item name="android:paddingEnd">@dimen/ds_space_6</item>
        <item name="android:textAppearance">@style/TextAppearance.Ds.LabelLarge</item>
        <item name="android:textColor">@color/ds_button_primary_fg</item>
        <item name="backgroundTint">@color/ds_button_primary_bg</item>
        <item name="rippleColor">@color/ds_ripple_on_primary</item>
        <item name="iconTint">@color/ds_button_primary_fg</item>
        <item name="iconSize">@dimen/ds_size_icon_medium</item>
        <item name="iconPadding">@dimen/ds_space_2</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ds.Button</item>
        <item name="elevation">@dimen/ds_elevation_level0</item>
    </style>

    <style name="Widget.Ds.Button.Primary.Large">
        <item name="android:minHeight">@dimen/ds_size_button_height_large</item>
        <item name="android:paddingStart">@dimen/ds_space_8</item>
        <item name="android:paddingEnd">@dimen/ds_space_8</item>
    </style>

    <!-- Визуально 40 dp (ds_size_button_height_small), зона касания добирается инсетами до 48 dp. -->
    <style name="Widget.Ds.Button.Primary.Small">
        <item name="android:minHeight">@dimen/ds_size_touch_target</item>
        <item name="android:insetTop">@dimen/ds_space_1</item>
        <item name="android:insetBottom">@dimen/ds_space_1</item>
        <item name="android:paddingStart">@dimen/ds_space_4</item>
        <item name="android:paddingEnd">@dimen/ds_space_4</item>
    </style>

    <style name="Widget.Ds.Button.Danger" parent="Widget.Ds.Button.Primary">
        <item name="android:textColor">@color/ds_button_danger_fg</item>
        <item name="backgroundTint">@color/ds_button_danger_bg</item>
        <item name="iconTint">@color/ds_button_danger_fg</item>
    </style>

    <style name="Widget.Ds.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <!-- При шрифте 200 % подпись переносится на вторую строку, кнопка растёт по высоте. -->
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">@dimen/ds_size_button_height</item>
        <item name="android:minWidth">@dimen/ds_size_touch_target</item>
        <item name="android:insetTop">@dimen/ds_space_0</item>
        <item name="android:insetBottom">@dimen/ds_space_0</item>
        <item name="android:paddingStart">@dimen/ds_space_6</item>
        <item name="android:paddingEnd">@dimen/ds_space_6</item>
        <item name="android:textAppearance">@style/TextAppearance.Ds.LabelLarge</item>
        <item name="android:textColor">@color/ds_content_on_surface</item>
        <item name="iconTint">@color/ds_content_on_surface</item>
        <item name="iconSize">@dimen/ds_size_icon_medium</item>
        <item name="iconPadding">@dimen/ds_space_2</item>
        <item name="strokeColor">@color/ds_button_secondary_stroke</item>
        <item name="strokeWidth">@dimen/ds_size_stroke_hairline</item>
        <item name="rippleColor">@color/ds_ripple_on_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ds.Button</item>
    </style>

    <style name="Widget.Ds.Button.Secondary.Small">
        <item name="android:minHeight">@dimen/ds_size_touch_target</item>
        <item name="android:insetTop">@dimen/ds_space_1</item>
        <item name="android:insetBottom">@dimen/ds_space_1</item>
        <item name="android:paddingStart">@dimen/ds_space_4</item>
        <item name="android:paddingEnd">@dimen/ds_space_4</item>
    </style>

    <style name="Widget.Ds.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <!-- При шрифте 200 % подпись переносится на вторую строку, кнопка растёт по высоте. -->
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">@dimen/ds_size_button_height</item>
        <item name="android:minWidth">@dimen/ds_size_touch_target</item>
        <item name="android:insetTop">@dimen/ds_space_0</item>
        <item name="android:insetBottom">@dimen/ds_space_0</item>
        <item name="android:paddingStart">@dimen/ds_space_3</item>
        <item name="android:paddingEnd">@dimen/ds_space_3</item>
        <item name="android:textAppearance">@style/TextAppearance.Ds.LabelLarge</item>
        <item name="android:textColor">@color/ds_content_on_surface</item>
        <item name="iconTint">@color/ds_content_on_surface</item>
        <item name="iconSize">@dimen/ds_size_icon_medium</item>
        <item name="rippleColor">@color/ds_ripple_on_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ds.Button</item>
    </style>

    <style name="Widget.Ds.Button.Ghost.Danger">
        <item name="android:textColor">@color/ds_content_danger</item>
        <item name="iconTint">@color/ds_content_danger</item>
    </style>

    <!-- Кнопки диалога: ghost, с подписью, выровненной по сетке. -->
    <style name="Widget.Ds.Button.Dialog" parent="Widget.Ds.Button.Ghost" />
    <style name="Widget.Ds.Button.Dialog.Danger" parent="Widget.Ds.Button.Ghost.Danger" />

    <!-- Иконка-кнопка 48×48 с иконкой 24 dp. contentDescription обязателен. -->
    <style name="Widget.Ds.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/ds_size_icon_button</item>
        <item name="android:minHeight">@dimen/ds_size_icon_button</item>
        <item name="android:insetTop">@dimen/ds_space_0</item>
        <item name="android:insetBottom">@dimen/ds_space_0</item>
        <item name="android:padding">@dimen/ds_space_3</item>
        <item name="iconSize">@dimen/ds_size_icon</item>
        <item name="iconPadding">@dimen/ds_space_0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/ds_content_on_surface</item>
        <item name="rippleColor">@color/ds_ripple_on_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ds.Corner.Full</item>
    </style>

    <style name="Widget.Ds.Button.Icon.Filled">
        <item name="backgroundTint">@color/ds_button_primary_bg</item>
        <item name="iconTint">@color/ds_button_primary_fg</item>
        <item name="rippleColor">@color/ds_ripple_on_primary</item>
    </style>

    <style name="Widget.Ds.Button.Icon.Tonal">
        <item name="backgroundTint">?attr/dsColorSurfaceContainerHigh</item>
    </style>

    <!-- Поверх фотографии: белая иконка на полупрозрачном круге (контраст не зависит от снимка). -->
    <style name="Widget.Ds.Button.Icon.OnPhoto">
        <item name="backgroundTint">?attr/dsColorPhotoScrim</item>
        <item name="iconTint">@color/ds_content_on_photo</item>
        <item name="rippleColor">@color/ds_content_on_photo</item>
    </style>

    <!-- Кнопка затвора Студии. -->
    <style name="Widget.Ds.Button.Shutter" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:minWidth">@dimen/ds_size_shutter_button</item>
        <item name="android:minHeight">@dimen/ds_size_shutter_button</item>
        <item name="android:insetTop">@dimen/ds_space_0</item>
        <item name="android:insetBottom">@dimen/ds_space_0</item>
        <item name="backgroundTint">?attr/dsColorOnCamera</item>
        <item name="iconTint">?attr/dsColorCameraBackground</item>
        <item name="iconSize">@dimen/ds_size_icon_large</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/ds_space_0</item>
        <item name="strokeColor">?attr/dsColorCameraBackground</item>
        <item name="strokeWidth">@dimen/ds_size_stroke_thick</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ds.Corner.Full</item>
    </style>
</resources>
