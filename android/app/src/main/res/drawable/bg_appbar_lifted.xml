<?xml version="1.0" encoding="utf-8"?>
<!-- App bar with a hairline at the bottom (mockup appbar lifted). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsColorOutlineVariant" />
        </shape>
    </item>
    <item android:bottom="@dimen/ds_size_stroke_hairline">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dsColorBackground" />
        </shape>
    </item>
</layer-list>
