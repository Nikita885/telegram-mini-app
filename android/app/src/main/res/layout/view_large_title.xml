<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup .large-title: kicker + display serif title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/ds_space_2"
    android:paddingBottom="@dimen/ds_space_4">

    <TextView
        android:id="@+id/kicker"
        style="@style/Widget.Ds.Text.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/title"
        style="@style/Widget.Ds.Text.ScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_1" />
</LinearLayout>
