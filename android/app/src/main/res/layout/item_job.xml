<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="top"
    android:minHeight="@dimen/ds_size_list_item_two_line_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_layout_gutter"
    android:paddingTop="@dimen/ds_layout_list_item_padding_vertical"
    android:paddingEnd="@dimen/ds_layout_gutter"
    android:paddingBottom="@dimen/ds_layout_list_item_padding_vertical">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="@dimen/studio_thumb"
        android:layout_height="@dimen/studio_thumb"
        android:background="@drawable/bg_thumb"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/dsColorOnSurface" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_0_5"
            android:drawablePadding="@dimen/ds_space_1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/dsColorOnSurfaceVariant" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:visibility="gone" />

        <app.outfitshare.feature.studio.StepsView
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="@dimen/studio_steps_height"
            android:layout_marginTop="@dimen/ds_space_2"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="@dimen/ds_size_icon_medium"
        android:layout_height="@dimen/ds_size_icon_medium"
        android:layout_gravity="center_vertical"
        android:importantForAccessibility="no"
        android:src="@drawable/ds_ic_chevron_right"
        android:visibility="gone"
        app:tint="?attr/dsColorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        style="@style/Widget.Ds.Button.Secondary.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:visibility="gone" />
</LinearLayout>
