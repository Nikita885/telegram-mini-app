<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <app.outfitshare.core.designsystem.component.image.AspectRatioImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/dsColorSurfaceSunken"
        android:scaleType="centerCrop"
        app:dsAspectRatio="@string/ds_aspect_outfit" />

    <ImageView
        android:id="@+id/badge"
        android:layout_width="@dimen/ds_size_icon_medium"
        android:layout_height="@dimen/ds_size_icon_medium"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/ds_space_2"
        android:importantForAccessibility="no"
        android:src="@drawable/ds_ic_remix"
        android:visibility="gone"
        app:tint="?attr/dsColorOnPhoto" />
</FrameLayout>
