<?xml version="1.0" encoding="utf-8"?>
<!-- Mockups «Профиль (свой)» and «Профиль (чужой)». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsColorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_size_app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_1"
        android:paddingEnd="@dimen/ds_space_1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Ds.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_back"
            android:visibility="gone"
            app:icon="@drawable/ds_ic_arrow_back" />

        <TextView
            android:id="@+id/handle_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/ds_space_3"
            android:paddingEnd="@dimen/ds_space_3"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/dsColorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studio"
            style="@style/Widget.Ds.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/studio_title"
            android:visibility="gone"
            app:icon="@drawable/ds_ic_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add"
            style="@style/Widget.Ds.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_new_outfit"
            android:visibility="gone"
            app:icon="@drawable/ds_ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu"
            style="@style/Widget.Ds.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_settings"
            app:icon="@drawable/ds_ic_settings" />
    </LinearLayout>

    <app.outfitshare.core.designsystem.component.banner.OfflineBanner
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ds_layout_gutter"
                        android:paddingTop="@dimen/ds_space_2"
                        android:paddingEnd="@dimen/ds_layout_gutter">

                        <LinearLayout
                            android:id="@+id/profile_head"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <app.outfitshare.core.designsystem.component.avatar.AvatarView
                                android:id="@+id/avatar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:dsAvatarSize="xl" />

                            <LinearLayout
                                android:id="@+id/counters"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_5"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/count_outfits"
                                    layout="@layout/view_counter"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/count_followers"
                                    layout="@layout/view_counter"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/count_following"
                                    layout="@layout/view_counter"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:drawablePadding="@dimen/ds_space_1"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/dsColorOnSurface" />

                        <TextView
                            android:id="@+id/bio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/dsColorOnSurface" />

                        <LinearLayout
                            android:id="@+id/buttons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_primary"
                                style="@style/Widget.Ds.Button.Secondary.Small"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <Space
                                android:layout_width="@dimen/ds_space_2"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_secondary"
                                style="@style/Widget.Ds.Button.Secondary.Small"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_space_4" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabGravity="fill"
                        app:tabMode="fixed" />

                    <com.google.android.material.divider.MaterialDivider
                        style="@style/Widget.Ds.Divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_tab_min_height">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_grid_gap"
                            android:nestedScrollingEnabled="false" />

                        <app.outfitshare.core.designsystem.component.state.StateView
                            android:id="@+id/tab_state"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/profile_tab_min_height"
                            app:dsLoadingLayout="@layout/skeleton_grid" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <app.outfitshare.core.designsystem.component.state.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
