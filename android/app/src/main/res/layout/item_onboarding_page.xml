<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/onboarding_photo_height"
        android:background="?attr/dsColorCanvas"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/kicker"
        style="@style/Widget.Ds.Text.Kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_layout_gutter"
        android:layout_marginTop="@dimen/ds_space_6"
        android:layout_marginEnd="@dimen/ds_layout_gutter" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_layout_gutter"
        android:layout_marginTop="@dimen/ds_space_2"
        android:layout_marginEnd="@dimen/ds_layout_gutter"
        android:accessibilityHeading="true"
        android:textAppearance="?attr/textAppearanceDisplaySmall"
        android:textColor="?attr/dsColorOnSurface" />

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_layout_gutter"
        android:layout_marginTop="@dimen/ds_space_3"
        android:layout_marginEnd="@dimen/ds_layout_gutter"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/dsColorOnSurfaceVariant" />
</LinearLayout>
