<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup «Публикация образа · Опубликовано» (also reused by the Studio «В каталоге» screen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsColorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_size_app_bar_height"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ds_space_1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Widget.Ds.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_close"
            app:icon="@drawable/ds_ic_close" />
    </LinearLayout>

    <app.outfitshare.core.designsystem.component.image.AspectRatioImageView
        android:id="@+id/image"
        style="@style/Widget.Ds.Photo"
        android:layout_width="@dimen/publish_success_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ds_space_4"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:dsAspectRatio="@string/ds_aspect_outfit" />

    <TextView
        android:id="@+id/kicker"
        style="@style/Widget.Ds.Text.Kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ds_space_6"
        android:drawablePadding="@dimen/ds_space_1"
        android:gravity="center_vertical"
        android:text="@string/publish_done"
        android:textColor="?attr/dsColorSuccess"
        app:drawableStartCompat="@drawable/badge_check"
        app:drawableTint="?attr/dsColorSuccess" />

    <TextView
        android:id="@+id/headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_layout_gutter"
        android:layout_marginTop="@dimen/ds_space_2"
        android:layout_marginEnd="@dimen/ds_layout_gutter"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/publish_done_title"
        android:textAppearance="?attr/textAppearanceHeadlineLarge"
        android:textColor="?attr/dsColorOnSurface" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primary"
        style="@style/Widget.Ds.Button.Primary.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_layout_gutter"
        android:layout_marginEnd="@dimen/ds_layout_gutter"
        android:text="@string/publish_view" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/secondary"
        style="@style/Widget.Ds.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_layout_gutter"
        android:layout_marginTop="@dimen/ds_space_2"
        android:layout_marginEnd="@dimen/ds_layout_gutter"
        android:layout_marginBottom="@dimen/ds_space_4"
        android:text="@string/publish_more" />
</LinearLayout>
