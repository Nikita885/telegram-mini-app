<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup .counter: number in the display serif, label under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/ds_size_touch_target"
    android:orientation="vertical">

    <TextView
        android:id="@+id/counter_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.Ds.Numeral"
        android:textColor="?attr/dsColorOnSurface" />

    <TextView
        android:id="@+id/counter_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/dsColorOnSurfaceVariant" />
</LinearLayout>
