<?xml version="1.0" encoding="utf-8"?>
<!-- Shared outfit card inside a bubble (mockup chat «shared»). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/chat_shared_card_width"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <app.outfitshare.core.designsystem.component.image.AspectRatioImageView
        android:id="@+id/card_photo"
        style="@style/Widget.Ds.Photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:dsAspectRatio="@string/ds_aspect_outfit" />

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <TextView
        android:id="@+id/card_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.75"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall" />
</LinearLayout>
