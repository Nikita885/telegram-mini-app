<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup «Студия: камера»: always the dark palette, live quality chips over the frame. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsColorCameraBackground"
    android:theme="@style/ThemeOverlay.Ds.Dark">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/studio_viewfinder"
        app:scaleType="fillCenter" />

    <View
        android:id="@+id/frame_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/studio_frame_side"
        android:layout_marginTop="@dimen/studio_frame_top"
        android:layout_marginEnd="@dimen/studio_frame_side"
        android:layout_marginBottom="@dimen/studio_frame_bottom"
        android:background="@drawable/bg_frame_guide"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/camera_flash"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_2"
        android:paddingTop="@dimen/ds_space_2"
        android:paddingEnd="@dimen/ds_space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close"
                style="@style/Widget.Ds.Button.Icon.OnPhoto"
                android:layout_width="@dimen/ds_size_icon_button"
                android:layout_height="@dimen/ds_size_icon_button"
                android:contentDescription="@string/action_close"
                app:icon="@drawable/ds_ic_close" />

            <TextView
                style="@style/Widget.Ds.Text.Kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/studio_title"
                android:textColor="?attr/dsColorOnCamera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flash_toggle"
                style="@style/Widget.Ds.Button.Icon.OnPhoto"
                android:layout_width="@dimen/ds_size_icon_button"
                android:layout_height="@dimen/ds_size_icon_button"
                android:contentDescription="@string/studio_flash"
                app:icon="@drawable/ds_ic_flash_off" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ds_space_3"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/q_light"
                style="@style/Studio.Quality"
                android:text="@string/studio_q_light" />

            <TextView
                android:id="@+id/q_background"
                style="@style/Studio.Quality"
                android:layout_marginStart="@dimen/ds_space_1"
                android:text="@string/studio_q_background" />

            <TextView
                android:id="@+id/q_frame"
                style="@style/Studio.Quality"
                android:layout_marginStart="@dimen/ds_space_1"
                android:text="@string/studio_q_frame" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_camera_bottom"
        android:orientation="vertical"
        android:paddingTop="@dimen/ds_space_6"
        android:paddingBottom="@dimen/ds_space_4">

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/ds_space_6"
            android:layout_marginEnd="@dimen/ds_space_6"
            android:background="@drawable/bg_camera_pill"
            android:gravity="center"
            android:paddingStart="@dimen/ds_space_3"
            android:paddingTop="@dimen/ds_space_1"
            android:paddingEnd="@dimen/ds_space_3"
            android:paddingBottom="@dimen/ds_space_1"
            android:text="@string/studio_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/dsColorOnCamera" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_3"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ds_layout_gutter"
                android:paddingEnd="@dimen/ds_layout_gutter"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gallery"
                    style="@style/Widget.Ds.Button.Icon.OnPhoto"
                    android:layout_width="@dimen/ds_size_icon_button"
                    android:layout_height="@dimen/ds_size_icon_button"
                    android:layout_gravity="center"
                    android:contentDescription="@string/studio_gallery"
                    app:icon="@drawable/ds_ic_gallery" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shutter"
                style="@style/Widget.Ds.Button.Shutter"
                android:layout_width="@dimen/ds_size_shutter_button"
                android:layout_height="@dimen/ds_size_shutter_button"
                android:contentDescription="@string/studio_shutter" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/queue"
                    style="@style/Widget.Ds.Button.Icon.OnPhoto"
                    android:layout_width="@dimen/ds_size_icon_button"
                    android:layout_height="@dimen/ds_size_icon_button"
                    android:layout_gravity="center"
                    android:contentDescription="@string/studio_queue"
                    app:icon="@drawable/ds_ic_queue" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ds_space_2"
            app:checkedButton="@+id/g_unisex"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/g_female"
                style="@style/Widget.Ds.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/studio_g_female"
                android:textColor="@color/camera_toggle_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/g_unisex"
                style="@style/Widget.Ds.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/studio_g_unisex"
                android:textColor="@color/camera_toggle_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/g_male"
                style="@style/Widget.Ds.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/studio_g_male"
                android:textColor="@color/camera_toggle_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <app.outfitshare.core.designsystem.component.state.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
