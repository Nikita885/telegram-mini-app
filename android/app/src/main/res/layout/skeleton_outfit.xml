<?xml version="1.0" encoding="utf-8"?>
<app.outfitshare.core.designsystem.component.skeleton.SkeletonLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <app.outfitshare.core.designsystem.component.image.AspectRatioImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ds_bg_skeleton_block"
            android:importantForAccessibility="no"
            app:dsAspectRatio="@string/ds_aspect_outfit" />

        <include layout="@layout/ds_skeleton_list_row" />

        <include
            layout="@layout/ds_skeleton_line_long"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_layout_gutter"
            android:layout_marginEnd="@dimen/ds_layout_gutter" />

        <include
            layout="@layout/ds_skeleton_line_short"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_layout_gutter"
            android:layout_marginTop="@dimen/ds_space_2"
            android:layout_marginEnd="@dimen/ds_layout_gutter" />
    </LinearLayout>
</app.outfitshare.core.designsystem.component.skeleton.SkeletonLayout>
