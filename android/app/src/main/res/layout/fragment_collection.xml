<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup «Коллекции · Коллекция». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dsColorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_size_app_bar_height"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ds_ic_arrow_back" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ds_layout_gutter"
            android:paddingEnd="@dimen/ds_layout_gutter"
            android:paddingBottom="@dimen/ds_space_6" />

        <app.outfitshare.core.designsystem.component.state.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
