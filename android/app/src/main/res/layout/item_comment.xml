<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_layout_gutter"
    android:paddingTop="@dimen/ds_layout_list_item_padding_vertical"
    android:paddingEnd="@dimen/ds_space_2"
    android:paddingBottom="@dimen/ds_space_1">

    <app.outfitshare.core.designsystem.component.avatar.AvatarView
        android:id="@+id/avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:dsAvatarDecorative="true"
        app:dsAvatarSize="s" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/dsColorOnSurfaceVariant" />

            <TextView
                android:id="@+id/author_badge"
                style="@style/Widget.Ds.TextBadge.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_1"
                android:text="@string/comments_author"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_0_5"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/dsColorOnSurface" />

        <TextView
            android:id="@+id/reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/ds_size_touch_target"
            android:text="@string/comments_reply"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/dsColorOnSurfaceVariant" />

        <TextView
            android:id="@+id/failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/ds_space_1"
            android:gravity="center_vertical"
            android:minHeight="@dimen/ds_size_touch_target"
            android:text="@string/comment_failed"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/dsColorDanger"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ds_ic_error"
            app:drawableTint="?attr/dsColorDanger" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/like"
        style="@style/Widget.Ds.Button.Ghost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:minWidth="@dimen/ds_size_touch_target"
        android:paddingStart="@dimen/ds_space_2"
        android:paddingEnd="@dimen/ds_space_2"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/dsColorOnSurfaceVariant"
        app:icon="@drawable/ds_ic_favorite_toggle"
        app:iconGravity="top"
        app:iconPadding="0dp"
        app:iconSize="@dimen/ds_size_icon_small"
        app:iconTint="@color/comment_like_tint" />
</LinearLayout>
