<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup .search: pill field with a search icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ds_size_touch_target"
    android:background="@drawable/bg_search_field"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_space_4"
    android:paddingEnd="@dimen/ds_space_1">

    <ImageView
        android:layout_width="@dimen/ds_size_icon_medium"
        android:layout_height="@dimen/ds_size_icon_medium"
        android:importantForAccessibility="no"
        android:src="@drawable/ds_ic_search"
        app:tint="?attr/dsColorOnSurfaceVariant" />

    <EditText
        android:id="@+id/search_input"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/ds_space_2"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/dsColorOnSurface"
        android:textColorHint="?attr/dsColorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_clear"
        style="@style/Widget.Ds.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/action_clear"
        android:visibility="gone"
        app:icon="@drawable/ds_ic_close"
        app:iconTint="?attr/dsColorOnSurfaceVariant" />
</LinearLayout>
