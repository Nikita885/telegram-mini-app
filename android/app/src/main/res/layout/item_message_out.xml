<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingTop="@dimen/chat_gap">

    <TextView
        android:id="@+id/day"
        style="@style/Widget.Ds.Text.Kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingTop="@dimen/ds_space_3"
        android:paddingBottom="@dimen/ds_space_3"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_out"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_3"
        android:paddingTop="@dimen/ds_space_2"
        android:paddingEnd="@dimen/ds_space_3"
        android:paddingBottom="@dimen/ds_space_2">

        <include
            android:id="@+id/card"
            layout="@layout/view_shared_outfit"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/bubble_max_width"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/dsColorOnPrimary" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:alpha="0.7"
            android:drawablePadding="@dimen/ds_space_0_5"
            android:textAppearance="@style/TextAppearance.Ds.LabelSmall"
            android:textColor="?attr/dsColorOnPrimary"
            app:drawableTint="?attr/dsColorOnPrimary" />
    </LinearLayout>

    <TextView
        android:id="@+id/failed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/ds_space_1"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ds_size_touch_target"
        android:text="@string/message_failed"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/dsColorDanger"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ds_ic_error"
        app:drawableTint="?attr/dsColorDanger" />
</LinearLayout>
