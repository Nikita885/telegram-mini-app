    "ghostLayer": 0.6
  },
  "motion": {
    "duration": {
      "$description": "мс. Все анимации масштабируются системной настройкой «Масштаб анимации» и выключаются при «Убрать анимации».",
      "micro": 100,
      "short": 150,
      "medium": 250,
      "long": 350,
      "extraLong": 500,
      "shimmer": 1400,
      "heartBurst": 700,
      "stagger": 30,
      "undoWindow": 5000,
      "snackbar": 4000,
      "splashMin": 600
    },
    "easing": {
      "standard": [0.2, 0.0, 0.0, 1.0],
      "standardDecelerate": [0.0, 0.0, 0.0, 1.0],
      "standardAccelerate": [0.3, 0.0, 1.0, 1.0],
      "emphasizedDecelerate": [0.05, 0.7, 0.1, 1.0],
      "emphasizedAccelerate": [0.3, 0.0, 0.8, 0.15],
      "linear": [0.0, 0.0, 1.0, 1.0]
    },
