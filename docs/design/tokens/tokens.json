    "16": 64,
    "20": 80,
    "24": 96
  },
  "layout": {
    "gutter": {"value": 20, "$description": "Боковые поля экрана (compact)."},
    "gutterMedium": {"value": 32, "$description": "Боковые поля на планшете (medium/expanded)."},
    "sectionGap": {"value": 40, "$description": "Вертикальный воздух между журнальными секциями."},
    "stackGap": {"value": 16, "$description": "Зазор между блоками в стеке."},
    "inlineGap": {"value": 8, "$description": "Зазор между элементами в строке."},
    "gridGap": {"value": 12, "$description": "Зазор сетки карточек."},
    "listItemPaddingVertical": {"value": 12, "$description": "Вертикальный паддинг строки списка."},
    "maxContentWidth": {"value": 640, "$description": "Максимальная ширина читаемой колонки на планшете."},
    "maxDialogWidth": {"value": 560, "$description": "Максимальная ширина диалога/снекбара."}
  },
  "breakpoint": {
