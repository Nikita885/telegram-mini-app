  "elevation": {
    "$description": "Журнальная эстетика — плоско. Тени тёплые, только у плавающих слоёв. В тёмной теме глубина передаётся тоном поверхности (surfaceContainer*), тень ослаблена.",
    "level0": {"dp": 0, "css": "none"},
    "level1": {"dp": 1, "css": "0 1px 2px rgba(28,27,25,.08), 0 1px 3px rgba(28,27,25,.06)"},
    "level2": {"dp": 3, "css": "0 2px 6px rgba(28,27,25,.08), 0 1px 2px rgba(28,27,25,.06)"},
    "level3": {"dp": 6, "css": "0 6px 16px rgba(28,27,25,.10), 0 2px 4px rgba(28,27,25,.06)"},
    "level4": {"dp": 8, "css": "0 10px 24px rgba(28,27,25,.12), 0 3px 6px rgba(28,27,25,.06)"},
    "level5": {"dp": 12, "css": "0 16px 40px rgba(28,27,25,.16), 0 4px 10px rgba(28,27,25,.06)"},
    "semantic": {
      "card": "level0",
      "appBarScrolled": "level1",
      "draggedLayer": "level4",
      "fab": "level3",
      "snackbar": "level3",
      "sheet": "level4",
      "dialog": "level5",
      "menu": "level3"
    },
    "shadowColor": {"light": "#1C1B19", "dark": "#000000"}
  },
