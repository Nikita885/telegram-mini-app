{
  "$description": "Outfit Share — единый источник дизайн-токенов. Из этого файла генерируются Android-ресурсы модуля :core:designsystem, CSS-переменные макетов и таблицы документации: python3 tools/designsystem/generate_tokens.py. Руками сгенерированные файлы не правим.",
  "meta": {
    "name": "Outfit Share Design System",
    "codename": "Atelier",
    "version": "1.0.0",
    "androidPrefix": "ds",
    "grid": 4
  },
  "color": {
    "primitive": {
      "milk": {"50": "#FCFAF6", "100": "#F6F2EB", "150": "#F1ECE4", "200": "#EFE9DF", "250": "#EAE3D8", "300": "#E4DCCF"},
      "stone": {"300": "#D8D2C9", "400": "#B8AEA1", "500": "#857C70", "550": "#8A8175", "600": "#6B6358", "700": "#544D45"},
      "graphite": {"600": "#45423D", "700": "#3A3733", "750": "#2F2D2A", "800": "#262422", "850": "#221F1D", "900": "#1C1B19", "950": "#131211", "1000": "#0B0B0A"},
      "ultramarine": {
        "100": "#E6E8FF",
        "200": "#C9CEFF",
        "300": "#A3ABFF",
        "400": "#7C87FF",
        "500": "#4C57F0",
        "600": "#2F3BD6",
        "700": "#232CA8",
        "800": "#1A2080",
        "850": "#262C8A",
        "900": "#10144F"
      },
      "red": {"100": "#FBE3DF", "300": "#FFB4A9", "600": "#B42318", "800": "#6E140D", "900": "#410A05"},
      "green": {"100": "#DDF1E4", "300": "#86D0A2", "600": "#1A6E3E", "800": "#123D25", "900": "#0B3A20"},
      "amber": {"100": "#FBEFD5", "300": "#F1C267", "700": "#8A5300", "800": "#3F2A06", "900": "#3A2400"},
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "semantic": {
      "background": {"light": "{milk.100}", "dark": "{graphite.950}", "$description": "Фон экрана. Молочный днём, почти чёрный графит ночью."},
      "onBackground": {"light": "{graphite.900}", "dark": "{milk.100}", "$description": "Основной текст и иконки на фоне."},
      "surface": {"light": "{milk.50}", "dark": "{graphite.900}", "$description": "Поднятые поверхности: bottom sheet, диалоги, меню."},
      "onSurface": {"light": "{graphite.900}", "dark": "{milk.100}", "$description": "Основной текст на поверхностях."},
      "onSurfaceVariant": {"light": "{stone.600}", "dark": "{stone.400}", "$description": "Вторичный текст: подписи, мета, плейсхолдеры, неактивные иконки."},
      "surfaceSunken": {"light": "{milk.200}", "dark": "{graphite.850}", "$description": "Утопленные зоны: плейсхолдер фото, поля ввода, плитка вещи."},
      "surfaceContainerLowest": {"light": "{milk.50}", "dark": "{graphite.950}", "$description": "M3 surfaceContainerLowest."},
      "surfaceContainerLow": {"light": "{milk.100}", "dark": "{graphite.900}", "$description": "M3 surfaceContainerLow."},
      "surfaceContainer": {"light": "{milk.150}", "dark": "{graphite.800}", "$description": "M3 surfaceContainer: навбар, карточки настроек."},
      "surfaceContainerHigh": {"light": "{milk.250}", "dark": "{graphite.750}", "$description": "M3 surfaceContainerHigh: выбранный элемент навигации, тональные зоны."},
      "surfaceContainerHighest": {"light": "{milk.300}", "dark": "{graphite.700}", "$description": "M3 surfaceContainerHighest: трек слайдера, разделители-плашки."},
      "outline": {"light": "{stone.500}", "dark": "{stone.550}", "$description": "Контур значимых элементов (поля, secondary-кнопка, чип). Контраст ≥ 3:1."},
      "outlineVariant": {"light": "{milk.300}", "dark": "{graphite.700}", "$description": "Декоративные разделители. Контраст не нормируется."},
      "primary": {
        "light": "{graphite.900}",
        "dark": "{milk.100}",
        "$description": "Главное действие (primary-кнопка). Графит днём, молочный ночью — монохром как в журнале."
      },
      "onPrimary": {"light": "{milk.50}", "dark": "{graphite.900}", "$description": "Текст/иконка на primary."},
      "accent": {
        "light": "{ultramarine.600}",
        "dark": "{ultramarine.300}",
        "$description": "Фирменный ультрамарин. Только «моменты»: лайк, непрочитанное, ссылки, фокус, snap-подсветка, прогресс."
      },
      "onAccent": {"light": "{white}", "dark": "{ultramarine.900}", "$description": "Контент на accent."},
      "accentContainer": {"light": "{ultramarine.100}", "dark": "{ultramarine.850}", "$description": "Мягкая подложка акцента: выбранный фильтр-чип «Новое», инфо-баннер."},
      "onAccentContainer": {"light": "{ultramarine.800}", "dark": "{ultramarine.100}", "$description": "Контент на accentContainer."},
      "danger": {"light": "{red.600}", "dark": "{red.300}", "$description": "Ошибки и разрушающие действия (удалить, выйти, заблокировать)."},
      "onDanger": {"light": "{milk.50}", "dark": "{red.900}", "$description": "Контент на danger."},
      "dangerContainer": {"light": "{red.100}", "dark": "{red.800}", "$description": "Подложка ошибки (баннер, поле с ошибкой)."},
      "onDangerContainer": {"light": "{red.800}", "dark": "{red.100}", "$description": "Контент на dangerContainer."},
      "success": {"light": "{green.600}", "dark": "{green.300}", "$description": "Успех: вещь опубликована, качество кадра ок, онлайн."},
      "successContainer": {"light": "{green.100}", "dark": "{green.800}", "$description": "Подложка успеха."},
      "onSuccessContainer": {"light": "{green.900}", "dark": "{green.100}", "$description": "Контент на successContainer."},
      "warning": {"light": "{amber.700}", "dark": "{amber.300}", "$description": "Предупреждение: слабый свет, низкий fit score, офлайн."},
      "warningContainer": {"light": "{amber.100}", "dark": "{amber.800}", "$description": "Подложка предупреждения (офлайн-баннер)."},
      "onWarningContainer": {"light": "{amber.900}", "dark": "{amber.100}", "$description": "Контент на warningContainer."},
      "inverseSurface": {"light": "{graphite.900}", "dark": "{milk.100}", "$description": "Снекбар, тултип."},
      "inverseOnSurface": {"light": "{milk.100}", "dark": "{graphite.900}", "$description": "Текст на inverseSurface."},
      "inverseAccent": {"light": "{ultramarine.300}", "dark": "{ultramarine.600}", "$description": "Действие в снекбаре («Отменить»)."},
      "like": {
        "light": "{ultramarine.600}",
        "dark": "{ultramarine.300}",
        "$description": "Заливка сердца. Совпадает с accent: лайк — главный эмоциональный момент бренда."
      },
      "focusRing": {"light": "{ultramarine.600}", "dark": "{ultramarine.300}", "$description": "Кольцо клавиатурного/switch-фокуса."},
      "scrim": {"light": "{graphite.900}", "dark": "{black}", "alpha": {"light": 0.48, "dark": 0.64}, "$description": "Затемнение под bottom sheet и диалогами."},
      "photoScrim": {
        "light": "{black}",
        "dark": "{black}",
        "alpha": {"light": 0.55, "dark": 0.6},
        "$description": "Нижний градиент на фото для подписи поверх изображения."
      },
      "onPhoto": {"light": "{white}", "dark": "{white}", "$description": "Текст/иконки поверх фото (всегда на photoScrim)."},
      "skeletonBase": {"light": "{milk.300}", "dark": "{graphite.800}", "$description": "Основа скелетона: заметно темнее фона, чтобы форма контента читалась."},
      "skeletonHighlight": {"light": "{milk.50}", "dark": "{graphite.750}", "$description": "Блик шиммера."},
      "canvas": {"light": "{milk.200}", "dark": "{graphite.850}", "$description": "Фон холста конструктора (студийная «бумага»)."},
      "mannequin": {"light": "{stone.300}", "dark": "{graphite.700}", "$description": "Заливка манекена."},
      "snapGuide": {
        "light": "{ultramarine.600}",
        "dark": "{ultramarine.300}",
        "alpha": {"light": 0.4, "dark": 0.5},
        "$description": "Подсветка зоны примагничивания на манекене."
      },
      "selection": {"light": "{ultramarine.600}", "dark": "{ultramarine.300}", "$description": "Рамка выбранного слоя / доводимой точки."},
      "cameraBackground": {"light": "{graphite.1000}", "dark": "{graphite.1000}", "$description": "Фон камеры Студии — всегда тёмный, чтобы не засвечивать кадр."},
      "onCamera": {"light": "{milk.100}", "dark": "{milk.100}", "$description": "Контролы поверх камеры."}
    },
    "avatar": {
      "$description": "Палитра аватаров-инициалов. Цвет выбирается стабильно по id пользователя. Светлая тема — пастель с графитовыми инициалами, тёмная — приглушённые тона с молочными.",
      "onAvatar": {"light": "{graphite.900}", "dark": "{milk.100}"},
      "palette": [
        {"name": "sand", "light": "#E5D3BC", "dark": "#5A4A38"},
        {"name": "sage", "light": "#CCD5C0", "dark": "#3F4A3A"},
        {"name": "mist", "light": "#C9D3DC", "dark": "#3A4652"},
        {"name": "blush", "light": "#E6CFCB", "dark": "#5A3F3C"},
        {"name": "lavender", "light": "#D6D1E6", "dark": "#45405A"},
        {"name": "ochre", "light": "#E4CE9C", "dark": "#5A4A22"},
        {"name": "stone", "light": "#D8D2C9", "dark": "#4A4540"}
      ]
    },
    "contrast": {
      "$description": "Пары, которые генератор проверяет по WCAG 2.2 в обеих темах. text — 1.4.3 (≥ 4.5:1), ui — 1.4.11 (≥ 3:1). Сборка токенов падает при нарушении.",
      "text": [
        ["onBackground", "background"],
        ["onSurface", "background"],
        ["onSurface", "surface"],
        ["onSurface", "surfaceSunken"],
        ["onSurface", "surfaceContainer"],
        ["onSurface", "surfaceContainerHigh"],
        ["onSurface", "surfaceContainerHighest"],
        ["onSurfaceVariant", "background"],
        ["onSurfaceVariant", "surface"],
        ["onSurfaceVariant", "surfaceSunken"],
        ["onSurfaceVariant", "surfaceContainer"],
        ["onSurfaceVariant", "surfaceContainerHigh"],
        ["onPrimary", "primary"],
        ["accent", "background"],
        ["accent", "surface"],
        ["onAccent", "accent"],
        ["onAccentContainer", "accentContainer"],
        ["danger", "background"],
        ["danger", "surface"],
        ["danger", "surfaceSunken"],
        ["onDanger", "danger"],
        ["onDangerContainer", "dangerContainer"],
        ["success", "background"],
        ["success", "surface"],
        ["success", "surfaceSunken"],
        ["onSuccessContainer", "successContainer"],
        ["warning", "background"],
        ["warning", "surface"],
        ["onWarningContainer", "warningContainer"],
        ["inverseOnSurface", "inverseSurface"],
        ["inverseAccent", "inverseSurface"],
        ["onCamera", "cameraBackground"]
      ],
      "ui": [
        ["outline", "background"],
        ["outline", "surface"],
        ["outline", "surfaceSunken"],
        ["outline", "surfaceContainerHigh"],
        ["primary", "background"],
        ["accent", "surfaceSunken"],
        ["like", "background"],
        ["like", "surface"],
        ["focusRing", "background"],
        ["selection", "canvas"],
        ["success", "cameraBackground"],
        ["warning", "cameraBackground"]
      ]
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "name": "OutfitShare Display",
        "upstream": "Playfair Display",
        "license": "OFL-1.1 (Reserved Font Name «Playfair Display» → производная переименована)",
        "android": "@font/ds_display",
        "css": "'OutfitShare Display', Georgia, 'Times New Roman', serif",
        "weights": [400, 500],
        "italic": [400]
      },
      "text": {
        "name": "Inter",
        "upstream": "Inter",
        "license": "OFL-1.1",
        "android": "@font/ds_text",
        "css": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "weights": [400, 500, 600],
        "italic": []
      }
    },
    "scale": {
      "displayLarge": {"family": "display", "weight": 400, "size": 48, "lineHeight": 52, "letterSpacing": -0.01, "$description": "Сплэш, онбординг, обложки коллекций."},
      "displayMedium": {
        "family": "display",
        "weight": 400,
        "size": 40,
        "lineHeight": 44,
        "letterSpacing": -0.01,
        "$description": "Заголовок экрана в hero-зоне (профиль, Студия)."
      },
      "displaySmall": {
        "family": "display",
        "weight": 400,
        "size": 32,
        "lineHeight": 38,
        "letterSpacing": -0.005,
        "$description": "Большой заголовок экрана (large top app bar)."
      },
      "headlineLarge": {"family": "display", "weight": 400, "size": 28, "lineHeight": 34, "letterSpacing": 0, "$description": "Заголовок раздела, пустые состояния."},
      "headlineMedium": {"family": "display", "weight": 500, "size": 24, "lineHeight": 30, "letterSpacing": 0, "$description": "Заголовок диалога, bottom sheet."},
      "headlineSmall": {"family": "display", "weight": 500, "size": 20, "lineHeight": 26, "letterSpacing": 0, "$description": "Имя в профиле, заголовок карточки коллекции."},
      "editorialQuote": {
        "family": "display",
        "weight": 400,
        "italic": true,
        "size": 20,
        "lineHeight": 28,
        "letterSpacing": 0,
        "$description": "Курсивная подпись к образу, цитата."
      },
      "numeral": {"family": "display", "weight": 500, "size": 22, "lineHeight": 26, "letterSpacing": 0, "$description": "Счётчики профиля (образы, подписчики)."},
      "titleLarge": {"family": "text", "weight": 600, "size": 18, "lineHeight": 24, "letterSpacing": 0, "$description": "Заголовок top app bar, заголовок строки."},
      "titleMedium": {"family": "text", "weight": 600, "size": 16, "lineHeight": 22, "letterSpacing": 0.005, "$description": "Имя автора, название вещи."},
      "titleSmall": {"family": "text", "weight": 500, "size": 14, "lineHeight": 20, "letterSpacing": 0.01, "$description": "Подзаголовки списков."},
      "bodyLarge": {"family": "text", "weight": 400, "size": 16, "lineHeight": 24, "letterSpacing": 0, "$description": "Основной текст, сообщения чата, поля ввода."},
      "bodyMedium": {"family": "text", "weight": 400, "size": 14, "lineHeight": 20, "letterSpacing": 0.005, "$description": "Комментарии, описания, строки списков."},
      "bodySmall": {"family": "text", "weight": 400, "size": 12, "lineHeight": 16, "letterSpacing": 0.01, "$description": "Мета: время, счётчики, подсказки."},
      "labelLarge": {"family": "text", "weight": 500, "size": 14, "lineHeight": 20, "letterSpacing": 0.01, "$description": "Кнопки, табы."},
      "labelMedium": {"family": "text", "weight": 500, "size": 12, "lineHeight": 16, "letterSpacing": 0.02, "$description": "Чипы, бейджи-текст, подписи иконок навбара."},
      "labelSmall": {
        "family": "text",
        "weight": 600,
        "size": 11,
        "lineHeight": 16,
        "letterSpacing": 0.08,
        "textTransform": "uppercase",
        "$description": "Кикер/надзаголовок в журнальном стиле: «НОВОЕ», «СТУДИЯ»."
      }
    }
  },
  "spacing": {
